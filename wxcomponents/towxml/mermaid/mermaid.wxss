.mermaid-wrap {
  position: relative;
  display: inline-block;
  margin: 10rpx 0;
  width: 100%;
  box-sizing: border-box;
}
/* 图表渲染中的骨架占位 */
.mermaid-skeleton {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f7;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
}
.mermaid-hint {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  margin-top: 4rpx;
}
.mermaid-fallback {
  margin: 10rpx 0;
  padding: 16rpx;
  background: #fff7f0;
  border: 1rpx solid #f0c8b0;
  border-radius: 8rpx;
}
.mermaid-fallback-tip {
  font-size: 24rpx;
  color: #e8804a;
  margin-bottom: 8rpx;
}
.mermaid-fallback-code {
  font-size: 22rpx;
  color: #666;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.5;
}
