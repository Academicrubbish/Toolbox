<view class="h2w__yumlBox">
    <view class="yuml-skeleton" wx:if="{{loading}}"><text>图表生成中...</text></view>
    <view wx:if="{{failed}}" class="yuml-fallback">⚠️ 图表渲染失败</view>
    <view style="width:{{size.w}}em;" class="h2w__yumlView">
        <image class="{{attr.class}}" src="{{attr.src}}" style="width:{{size.w}}em; height:{{size.h}}em;" mode="aspectFill" bindload="load" binderror="onImgError" catch:tap="onTap"></image>
        <view class="yuml-hint" wx:if="{{!loading && !failed && attr.src}}">点击查看大图</view>
    </view>
    <chart-preview id="chartPreview" />
</view>
