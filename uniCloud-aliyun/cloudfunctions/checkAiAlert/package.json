{
  "name": "checkAiAlert",
  "version": "1.0.0",
  "description": "AI 调用监控：定时扫描日累计消耗与失败率，命中阈值写入 ai_alerts 告警",
  "main": "index.js",
  "dependencies": {},
  "cloudfunction-config": {
    "memorySize": 256,
    "timeout": 60,
    "triggers": [
      {
        "name": "checkAiAlertTimer",
        "type": "timer",
        "config": "0 7 * * * * *"
      }
    ]
  }
}
